[
  {
    "name": "get_account_context",
    "description": "Everything visible about one account: company, contacts, open deals with partner credit, contracts, latest evidence, last three strategy versions with their reviews, open commitments, and whether the account is in an experiment holdout.",
    "input_schema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "integer"
        }
      },
      "required": [
        "company_id"
      ]
    }
  },
  {
    "name": "search_evidence",
    "description": "Search evidence about one subject, newest first, excluding superseded rows.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "contact",
            "deal",
            "partner",
            "territory",
            "skill",
            "loop"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "since": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "subject_type",
        "subject_id"
      ]
    }
  },
  {
    "name": "get_policies",
    "description": "Active rules of engagement, and for a contact: do-not-contact status, touches in the last 14 days, and partner credit on the account.",
    "input_schema": {
      "type": "object",
      "properties": {
        "contact_id": {
          "type": "integer"
        }
      },
      "required": []
    }
  },
  {
    "name": "record_evidence",
    "description": "Record one sourced observation. Strength is set by the database from the kind.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "contact",
            "deal",
            "partner",
            "territory",
            "skill",
            "loop"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "call_quote",
            "email_from_contact",
            "signature_block",
            "meeting_attended",
            "product_usage",
            "crm_record",
            "rep_observation",
            "partner_report",
            "enrichment_vendor",
            "web_page",
            "social_post",
            "inferred"
          ]
        },
        "claim": {
          "type": "string",
          "description": "The observation in one or two sentences. Quote when quoting."
        },
        "source_uri": {
          "type": "string",
          "description": "Where a human can check it: call link with timestamp, email id, URL"
        },
        "observed_at": {
          "type": "string",
          "description": "ISO timestamp of when it was observed"
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "kind",
        "claim",
        "source_uri",
        "observed_at"
      ]
    }
  },
  {
    "name": "supersede_evidence",
    "description": "Mark an older evidence row as superseded by a newer one about the same subject.",
    "input_schema": {
      "type": "object",
      "properties": {
        "old_id": {
          "type": "integer"
        },
        "new_id": {
          "type": "integer"
        }
      },
      "required": [
        "old_id",
        "new_id"
      ]
    }
  },
  {
    "name": "propose_decision",
    "description": "Propose a decision for human review, citing at least one evidence id. Actions used by the write tools: propose_strategy, update_field (payload: table, field, row_id, value), schedule_touch, propose_skill_version. Other actions (flag_risk, propose_partner, ...) are recommendations a human acts on.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "contact",
            "deal",
            "partner",
            "territory",
            "skill",
            "loop"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "action",
        "subject_type",
        "subject_id",
        "rationale",
        "evidence_ids"
      ]
    }
  },
  {
    "name": "propose_strategy",
    "description": "File a new strategy version for an account, partner or territory. Every evidence id in the plan must be cited by the decision.",
    "input_schema": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "integer"
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "partner",
            "territory"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "plan": {
          "type": "object"
        }
      },
      "required": [
        "decision_id",
        "subject_type",
        "subject_id",
        "plan"
      ]
    }
  },
  {
    "name": "apply_field_update",
    "description": "Change one allowlisted field, citing an update_field decision with strong evidence. Applies at level 3 and above, queues for the record owner at level 2.",
    "input_schema": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "integer"
        },
        "table": {
          "type": "string",
          "enum": [
            "deals",
            "contacts",
            "companies"
          ]
        },
        "row_id": {
          "type": "integer"
        },
        "field": {
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "decision_id",
        "table",
        "row_id",
        "field",
        "value"
      ]
    }
  },
  {
    "name": "schedule_touch",
    "description": "Schedule an outbound touch for a schedule_touch decision. Policies are checked by the database.",
    "input_schema": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "integer"
        },
        "contact_id": {
          "type": "integer"
        },
        "channel": {
          "type": "string",
          "enum": [
            "email",
            "call",
            "linkedin",
            "meeting",
            "partner_intro",
            "sms",
            "event"
          ]
        },
        "sender_type": {
          "type": "string",
          "enum": [
            "agent",
            "rep",
            "executive",
            "partner",
            "se"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "content_ref": {
          "type": "string"
        },
        "scheduled_for": {
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "contact_id",
        "channel",
        "sender_type",
        "purpose"
      ]
    }
  },
  {
    "name": "create_commitment",
    "description": "Record something our side promised the customer, pointing to the evidence of the promise.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "company"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "promise": {
          "type": "string"
        },
        "due_on": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "evidence_id": {
          "type": "integer"
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "promise",
        "evidence_id"
      ]
    }
  },
  {
    "name": "escalate",
    "description": "Hand a case to a named human with the reason. Use when unsure or when evidence conflicts.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "contact",
            "deal",
            "partner",
            "territory",
            "skill",
            "loop"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "to_user": {
          "type": "string",
          "description": "auth user id of an active human"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "to_user",
        "reason"
      ]
    }
  },
  {
    "name": "propose_skill_version",
    "description": "Propose a new version of a skill file, citing a propose_skill_version decision. An owner approves it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "name",
        "body"
      ]
    }
  }
]
