<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>EA Agent Writer</label>
    <description>For the earned-autonomy integration user only. Read the objects agents reason about; edit only the allowlisted fields. No delete, no owner changes, no amounts.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Opportunity</object>
        <allowRead>true</allowRead><allowEdit>true</allowEdit>
        <allowCreate>false</allowCreate><allowDelete>false</allowDelete>
        <modifyAllRecords>false</modifyAllRecords><viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowRead>true</allowRead><allowEdit>true</allowEdit>
        <allowCreate>false</allowCreate><allowDelete>false</allowDelete>
        <modifyAllRecords>false</modifyAllRecords><viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowRead>true</allowRead><allowEdit>false</allowEdit>
        <allowCreate>false</allowCreate><allowDelete>false</allowDelete>
        <modifyAllRecords>false</modifyAllRecords><viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><field>Opportunity.StageName</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Opportunity.CloseDate</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Opportunity.Description</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Opportunity.Amount</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Opportunity.EA_Decision_Id__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Contact.Title</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Contact.EA_Decision_Id__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Account.EA_Territory_Key__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
</PermissionSet>
